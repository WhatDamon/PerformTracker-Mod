{
	"schemaVersion": 1,
	"id": "performtracker",
	"version": "${version}",
	"name": "PerformTracker",
	"description": "A Simple Performance Tracker",
	"authors": [
		"WhatDamon"
	],
	"contact": {
		"sources": "https://github.com/WhatDamon/PerformTracker-Mod"
	},
	"license": "Apache 2.0",
	"icon": "assets/performtracker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.damon233.performtrackermod.PerformTracker"
		],
		"client": [
			"org.damon233.performtrackermod.PerformTrackerClient"
		],
		"modmenu": [
			"org.damon233.performtrackermod.config.PerformTrackerModMenuIntegration"
		]
	},
	"mixins": [
		"performtracker.mixins.json",
		{
			"config": "performtracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"optionalDependencies": [
		"cloth-config"
	]
}